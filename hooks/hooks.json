{
  "description": "servio-agent: block Bash commands that would read .env files on servers or private keys anywhere.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-secrets.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
